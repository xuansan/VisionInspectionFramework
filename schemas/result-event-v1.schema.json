{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vision result-event v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_type": {
      "const": "inspection.finalized"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical decimal uint64. Reader additionally enforces <=18446744073709551615."
    },
    "emitted_at_unix_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical decimal uint64. Reader additionally enforces <=18446744073709551615."
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "sequence",
    "emitted_at_unix_ns",
    "result"
  ],
  "additionalProperties": false,
  "$defs": {
    "correlation": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "worker_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "worker_epoch": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Canonical decimal uint64. Reader additionally enforces <=18446744073709551615."
        },
        "inspection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "check_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "attempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Canonical decimal uint64. Reader additionally enforces <=18446744073709551615."
        }
      },
      "required": [
        "run_id",
        "worker_id",
        "worker_epoch",
        "inspection_id",
        "check_id",
        "task_id",
        "attempt"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "category": {
          "enum": [
            "Configuration",
            "Protocol",
            "Device",
            "Execution",
            "Resource",
            "Persistence",
            "Delivery",
            "Internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000]+$"
        },
        "retryability": {
          "enum": [
            "Never",
            "AfterRecovery",
            "Safe"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "correlation": {
          "$ref": "#/$defs/correlation"
        },
        "vendor_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryability",
        "origin"
      ],
      "additionalProperties": false
    },
    "defect": {
      "type": "object",
      "properties": {
        "class_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "box_xyxy": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "maxItems": 4,
          "minItems": 4
        },
        "coordinate_space": {
          "const": "original_pixels"
        }
      },
      "required": [
        "class_id",
        "label",
        "score",
        "box_xyxy",
        "coordinate_space"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[^\\u0000]+$"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "correlation": {
          "$ref": "#/$defs/correlation"
        },
        "execution_state": {
          "enum": [
            "Succeeded",
            "Failed",
            "Cancelled",
            "TimedOut"
          ]
        },
        "quality": {
          "enum": [
            "Unknown",
            "OK",
            "NG"
          ]
        },
        "defects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/defect"
          },
          "maxItems": 4096,
          "minItems": 0
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          },
          "maxItems": 256,
          "minItems": 0
        },
        "elapsed_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "Canonical decimal uint64. Reader additionally enforces <=18446744073709551615."
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "model_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "masks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "instance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "storage": {
                "const": "local_ephemeral"
              }
            },
            "required": [
              "hash",
              "width",
              "height",
              "instance",
              "storage"
            ],
            "additionalProperties": false
          },
          "maxItems": 64,
          "minItems": 0
        }
      },
      "required": [
        "correlation",
        "execution_state",
        "quality",
        "defects",
        "measurements",
        "elapsed_ns"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "Succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "quality": {
                "enum": [
                  "OK",
                  "NG"
                ]
              }
            },
            "not": {
              "required": [
                "error"
              ]
            }
          },
          "else": {
            "properties": {
              "quality": {
                "const": "Unknown"
              }
            },
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "inspection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "workpiece_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "station_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "mode": {
          "enum": [
            "Demo",
            "Replay",
            "Production"
          ]
        },
        "recipe_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "execution_state": {
          "enum": [
            "Completed",
            "Failed",
            "Cancelled",
            "TimedOut"
          ]
        },
        "quality": {
          "enum": [
            "Unknown",
            "OK",
            "NG"
          ]
        },
        "expected_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "check_id",
              "required"
            ],
            "additionalProperties": false
          },
          "maxItems": 64,
          "minItems": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "maxItems": 64,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000]+$"
        }
      },
      "required": [
        "run_id",
        "inspection_id",
        "workpiece_id",
        "station_id",
        "mode",
        "recipe_hash",
        "execution_state",
        "quality",
        "expected_checks",
        "checks",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "Completed"
              }
            }
          },
          "then": {
            "properties": {
              "quality": {
                "enum": [
                  "OK",
                  "NG"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "quality": {
                "const": "Unknown"
              }
            }
          }
        }
      ]
    }
  }
}
